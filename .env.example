# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Optional overrides
ANGEL_BASE_URL=https://apiconnect.angelone.in
SCRIP_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json

# Market / Engine
UNDERLYING=NIFTY
UNDERLYING_TOKEN=26000
EXCHANGE=NSE
EXCHANGE_TYPE_NSE=1
EXCHANGE_TYPE_NFO=2
STRIKE_INTERVAL=50
CANDIDATE_COUNT=10
EXPIRY_MODE=current_weekly

# Market session (IST)
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
PRE_OPEN_START=09:00
POST_CLOSE_END=15:45

# Cycle
CYCLE_SECONDS=60

# Gates
MIN_SCORE=75
MIN_CONFIDENCE=70
MIN_DATA_QUALITY=75
MIN_RR=1.5
MAX_SPREAD_PERCENT=8
MAX_STALE_SECONDS=20

# Source behavior
ALLOW_JUGAAD_FALLBACK=true
ALLOW_CALCULATED_GREEKS=true

# DB
DB_PATH=data/history.db
LOG_DIR=data/logs

# Telegram notifications
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
